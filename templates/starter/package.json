{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"{src,packages/*/src,packages/*/test,ui-check,scripts}/**/*.{ts,tsx,css,mjs}\"",
    "format:check": "prettier --check \"{src,packages/*/src,packages/*/test,ui-check,scripts}/**/*.{ts,tsx,css,mjs}\"",
    "ui:check": "playwright test",
    "smoke:prod": "playwright test -c playwright.prod.config.ts",
    "verify": "npm run build && npm run lint && npm run format:check && npm test && npm run smoke:prod && npm run ui:check",
    "report:demo": "node --import tsx scripts/demo-report.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@windev-migration/ui": "0.1.0",
    "@windev-migration/reports": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "@windev-migration/testing": "0.1.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {"node": ">=24.22.1 <25", "npm": ">=11.19.1 <12"},
  "packageManager": "npm@11.19.1"
}
