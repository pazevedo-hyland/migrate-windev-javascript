{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./legacy/**)",
      "Edit(./analysis-local/**)",
      "Edit(./scripts/guard.py)",
      "Edit(./.githooks/**)",
      "Edit(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard.py\" --hook"
          }
        ]
      }
    ]
  }
}
