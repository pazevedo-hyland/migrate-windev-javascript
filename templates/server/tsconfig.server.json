{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "bundler",
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true, "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node", "vite/client"]
  },
  "include": ["server/**/*.ts", "src/backend", "src/shared", "src/infrastructure/backend.ts", "tools/*.ts"]
}
